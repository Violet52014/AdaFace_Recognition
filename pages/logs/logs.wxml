<view class="container">
  <!-- 标题栏 -->
  <view class="title-bar">
    <text class="title-text">识别记录</text>
  </view>
  
  <!-- 统计卡片 -->
  <view class="stats-summary">
    <view class="stat-item">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">总记录数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{successCount}}</text>
      <text class="stat-label">识别成功</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{errorCount}}</text>
      <text class="stat-label">识别失败</text>
    </view>
  </view>
  
  <!-- 清空记录按钮 -->
  <view class="clear-button-wrapper">
    <button class="clear-btn" bindtap="clearRecords">清空记录</button>
  </view>
  
  <!-- 记录列表 -->
  <scroll-view 
    class="logs-list" 
    scroll-y 
    bindscrolltolower="loadMore"
    lower-threshold="100"
  >
    <view class="list-item" wx:for="{{logs}}" wx:key="id" wx:for-item="log">
      <image class="item-avatar" src="{{log.avatar || '/images/default-avatar.png'}}"></image>
      
      <view class="item-info">
        <view class="info-header">
          <text class="info-name">{{log.name}}</text>
          <text class="info-status {{log.status === 'success' ? 'success' : 'error'}}">
            {{log.status === 'success' ? '识别成功' : '识别失败'}}
          </text>
        </view>
        <text class="info-class" wx:if="{{log.class}}">{{log.class}}</text>
        <text class="info-time">{{log.time}}</text>
        <text class="info-desc">{{log.description}}</text>
      </view>
    </view>
    
    <view class="loading-more" wx:if="{{hasMore}}">
      <text>加载更多...</text>
    </view>
    
    <view class="no-more" wx:if="{{!hasMore && logs.length > 0}}">
      <text>没有更多记录了</text>
    </view>
    
    <view class="empty" wx:if="{{logs.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/empty.png"></image>
      <text class="empty-text">暂无识别记录</text>
      <text class="empty-tip">请返回首页进行人脸识别</text>
    </view>
  </scroll-view>
</view>